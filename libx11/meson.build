libx11_c_args = [
  '-D_BSD_SOURCE',
  '-DX11_t',
  '-DTRANS_CLIENT',
  '-DXKB',
  '-D_GNU_SOURCE',
  '-DXLOCALEDIR="/usr/share/X11/locale"',
  '-DXLOCALELIBDIR="/usr/lib/X11/locale"',
  '-DXCMSDIR="/usr/share/X11"',
  '-DUSE_DYNAMIC_LC=1',
]

libX11 = shared_library('X11',
  libx11_sources,
  ks_tables_h,
  include_directories: inc,
  dependencies: libx11_deps,
  c_args: libx11_c_args,
  version: '6.4.0',
  install: true
)

libX11_dep = declare_dependency(
  link_with: libX11,
  include_directories: inc,
  dependencies: libx11_deps
)

# libX11-xcb
libX11_xcb = shared_library('X11-xcb',
  'src/x11_xcb.c',
  include_directories: inc,
  dependencies: [xcb_dep, libX11_dep],
  c_args: libx11_c_args,
  version: '1.0.0',
  install: true
)
