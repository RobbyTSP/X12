project('libX11', 'c',
  version: '1.8.7',
  meson_version: '>= 0.50.0',
  default_options: ['c_std=gnu99', 'warning_level=1']
)

cc = meson.get_compiler('c')

# Dependencies
xproto_dep = dependency('xproto', version: '>= 7.0.17')
xextproto_dep = dependency('xextproto', required: false)
xtrans_dep = dependency('xtrans')
xcb_dep = dependency('xcb', version: '>= 1.11.1')
xcb_errors_dep = dependency('xcb-errors', required: false)
kbproto_dep = dependency('kbproto')
inputproto_dep = dependency('inputproto')

dep_threads = dependency('threads')

libx11_deps = [
  xproto_dep,
  xcb_dep,
  kbproto_dep,
  inputproto_dep,
  dep_threads,
]

# Include directories
inc = include_directories('include', 'include/X11', 'src', 'src/xkb')

# Compile makekeys utility for the build host
makekeys_exe = executable('makekeys',
  'src/util/makekeys.c',
  native: true,
  include_directories: inc
)

# Find keysymdef.h
xproto_prefix = xproto_dep.get_variable(pkgconfig: 'prefix', default_value: '/usr')
keysymdef = xproto_prefix / 'include/X11/keysymdef.h'
if not cc.has_header('X11/keysymdef.h', args: '-I' + xproto_prefix / 'include')
  # fallback to system check
  keysymdef = '/usr/include/X11/keysymdef.h'
endif

# Generate ks_tables.h
ks_tables_h = custom_target('ks_tables.h',
  output: 'ks_tables.h',
  input: keysymdef,
  command: [makekeys_exe, '@INPUT@'],
  capture: true
)

